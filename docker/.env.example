# Docker environment configuration for Project RawHorse
# Copy to .env and modify for your deployment

# Domain for HTTPS (replace with your domain)
DOMAIN=localhost

# Database configuration
DB_PASSWORD=your-secure-password-here
DATABASE_URL=postgresql://prh:${DB_PASSWORD}@db:5432/rawhorse

# Redis configuration
REDIS_URL=redis://cache:6379/0

# Application settings
SECRET_KEY=generate-a-secure-random-key-here
ENVIRONMENT=production
DEBUG=false

# GitHub integration (optional - for PR automation)
GITHUB_TOKEN=your-github-token-here

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=60
