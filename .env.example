# Project RawHorse - copy to .env and adjust as needed
# SECRET_KEY is auto-generated on first run if not set; do not commit .env

# ---------- Local Development (default) ----------
# Security
SECRET_KEY=
AUTH_ENABLED=false

# Database (SQLite for local dev)
DATABASE_URL=sqlite:///data/prh.db
# SQLITE_PATH=data/prh.db

# Server
HOST=127.0.0.1
PORT=8000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Optional: comma-separated list of allowed Host headers (empty = allow any)
# TRUSTED_HOSTS=localhost,127.0.0.1

# ---------- Docker / VPS Production ----------
# Uncomment and fill these for Docker Compose deployment:
# DOMAIN=your-domain.com
# DB_PASSWORD=your-secure-db-password
# DATABASE_URL=postgresql://prh:${DB_PASSWORD}@db:5432/rawhorse
# REDIS_URL=redis://cache:6379/0
# SECRET_KEY=generate-a-64-char-random-key
# ENVIRONMENT=production
# DEBUG=false
# GITHUB_TOKEN=your-github-token
