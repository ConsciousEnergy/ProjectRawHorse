# Project RawHorse - copy to .env and adjust as needed
# SECRET_KEY is auto-generated on first run if not set; do not commit .env

# Security
SECRET_KEY=
AUTH_ENABLED=false

# Database
DATABASE_URL=sqlite:///data/prh.db
# SQLite path (used when DATABASE_URL is not set)
# SQLITE_PATH=data/prh.db

# Server
HOST=127.0.0.1
PORT=8000

# Rate limiting (requests per minute)
RATE_LIMIT_PER_MINUTE=100

# Optional: comma-separated list of allowed Host headers (empty = allow any)
# TRUSTED_HOSTS=localhost,127.0.0.1
